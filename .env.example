# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# Bot Settings - Channel Names (must match exactly)
CREATE_CHANNEL_NAME=🏴〢Set Sail Together
CATEGORY_NAME=✘ SOCIAL ✘
CATEGORY_ID=1406361945577095168

# Bot Behavior Settings
DELETE_DELAY=1000

# Audio Settings
AUDIO_VOLUME=0.4

# Voice Logging Settings
ENABLE_VOICE_LOGGING=true
VOICE_LOG_CHANNEL_ID=your_voice_log_channel_id_here
# VOICE_LOG_CHANNEL=voice-activity-log (fallback if no ID provided)

# XP System Configuration
XP_PER_MINUTE=5          # XP earned per minute in voice chat
DAILY_XP_CAP=500         # Maximum XP that can be earned per day
WEEKLY_XP_CAP=2500       # Maximum XP that can be earned per week
MONTHLY_XP_CAP=10000     # Maximum XP that can be earned per month

# PostgreSQL Database Configuration (Railway)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Alternative PostgreSQL Configuration (if not using DATABASE_URL)
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGUSER=${{Postgres.PGUSER}}
# PGPASSWORD=${{Postgres.PGPASSWORD}}
# PGDATABASE=${{Postgres.PGDATABASE}}

# Environment Settings
NODE_ENV=production
DEBUG=true
